{
  "workbench.colorTheme": "Monokai",
  "workbench.iconTheme": "vs-seti",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', Menlo, Monaco, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.lineHeight": 24,
  "editor.cursorBlinking": "phase",
  "editor.cursorStyle": "line",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "boundary",
  "editor.smoothScrolling": true,
  "editor.wordWrap": "on",
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', Menlo, Monaco, Consolas, 'Courier New', monospace",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "workbench.colorCustomizations": {
    "editor.background": "#050807",
    "editor.foreground": "#D7FFD7",
    "editorCursor.foreground": "#00FF66",
    "editorLineNumber.foreground": "#236B3A",
    "editorLineNumber.activeForeground": "#00FF66",
    "editor.selectionBackground": "#00FF6633",
    "editor.inactiveSelectionBackground": "#00FF661A",
    "editor.lineHighlightBackground": "#00FF660D",
    "editorBracketMatch.background": "#00FF6626",
    "editorBracketMatch.border": "#00FF66",
    "sideBar.background": "#030504",
    "sideBar.foreground": "#9EF59E",
    "activityBar.background": "#020302",
    "activityBar.foreground": "#00FF66",
    "statusBar.background": "#05240F",
    "statusBar.foreground": "#B7FFB7",
    "titleBar.activeBackground": "#030504",
    "titleBar.activeForeground": "#B7FFB7",
    "terminal.background": "#030504",
    "terminal.foreground": "#00FF66",
    "terminalCursor.foreground": "#00FF66"
  }
}
